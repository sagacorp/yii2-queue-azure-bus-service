{
  "name": "sagacorp/yii2-queue-azure-service-bus",
  "description": "Yii2 Queue driver for Azure service bus",
  "license": "MIT",
  "keywords": ["azure", "service", "microsoft", "bus", "yii2-queue", "yii2", "queue", "yii"],
  "type": "yii2-extension",
  "authors": [
    {
      "name": "Adrien Herbert"
    },
    {
      "name": "Aurélien Chrétien"
    }
  ],
  "require": {
    "php": "^8.3",
    "azure-oss/identity": "^1.0",
    "nesbot/carbon": "^2.0 | ^3.0",
    "sagacorp/yii2-queue-contracts": "^1.0",
    "yiisoft/yii2-httpclient": "^2.0",
    "yiisoft/yii2-queue": "^2.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "guzzlehttp/guzzle": "^7.10",
    "rector/rector": "^2.1",
    "laravel/pint": "^1.24"
  },
  "suggest": {
    "guzzlehttp/guzzle": "Required by WorkloadIdentityTokenProvider: any PSR-18 HTTP client + PSR-17 factories (e.g. guzzlehttp/guzzle) to exchange the federated token for an Azure AD access token."
  },
  "autoload": {
    "psr-4": {
      "sagacorp\\queue\\azure\\": "src"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true
    }
  }
}
